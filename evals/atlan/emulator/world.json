  {
   "name": "extension__skill__create",
   "description": "Create skills from exactly one of a bounded inline text files map or a registered ZIP bundle_file_id per skill. Creation does not publish; existing validation and scan gates still apply.",
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "skills": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "workspace_id": {
         "type": "string"
        },
        "bundle_file_id": {
         "type": "string"
        },
        "files": {
         "type": "object",
         "additionalProperties": {
          "type": "string"
         },
         "description": "Text files, including root SKILL.md; batch maximum 256 KiB and 128 files."
        }
       },
       "required": [
        "name",
        "workspace_id"
       ],
       "oneOf": [
        {
         "required": [
          "files"
         ],
         "not": {
          "required": [
           "bundle_file_id"
          ]
         }
        },
        {
         "required": [
          "bundle_file_id"
         ],
         "not": {
          "required": [
           "files"
          ]
         }
        }
       ]
      }
     }
    },
    "required": [
     "skills"
    ]
   },
   "writes": "skill"
  },
  {
   "name": "extension__agent__session_read",
   "description": "Read what was said in one of your project's chats, as a project's Claw: `turns` in order. Private chats and chats outside your project cannot be read.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "session_id": {
      "type": "string"
     },
     "after": {
      "type": "integer"
     },
     "before": {
      "type": "integer"
     },
     "from_end": {
      "type": "boolean"
     }
    },
    "required": [
     "session_id"
    ]
   },
   "refuse": {
    "status": 403,
    "code": "access_denied",
    "detail": "Only a project's Claw, acting directly or as the actor in a verified delegation, can use the Claw session tools. A person, a service or an unattributed delegation cannot."
   }
  },
  {
   "name": "extension__agent__session_list",
