   },
   "refuse": {
    "status": 403,
    "code": "access_denied",
    "detail": "Only a project's Claw, acting directly or as the actor in a verified delegation, can use the Claw session tools."
   }
  },
  {
   "name": "extension__agent__list_session_traces",
   "description": "Find the trace for an uploaded transcript: the runtime view of a session. A session is joined to its spans by `external_session_id`. Open a listed run with `get_trace` or `get_trace_spans`, passing this `session_\u2026` handle as their `subject_id`.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "session_id": {
      "type": "string"
     },
     "cursor": {
      "type": "string"
     },
     "limit": {
      "type": "integer"
     }
    },
    "required": [
     "session_id"
    ]
   }
  },
  {
   "name": "extension__agent__get_trace",
   "description": "Read one run of an agent or harness: timing, cost, status and shape. `include: [\"content\"]` adds its request and final reply. For a run `list_session_traces` listed, pass that `session_\u2026` handle as `subject_id`. Scoped to the subject.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "subject_id": {
      "type": "string",
      "description": "`agent_\u2026` or `harness_\u2026`, or the `session_\u2026` handle a `list_session_traces` run came from."
     },
     "trace_id": {
      "type": "string"
     },
     "include": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "subject_id",
     "trace_id"
    ]
   }
  },
  {
   "name": "extension__agent__get_trace_spans",
   "description": "Read the steps inside one run. `include` adds `content`, `errors` or `attributes`. Narrow before you widen: `errors_only` and `names` filter; a step's content can run to hundreds of thousands of characters.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "subject_id": {
      "type": "string",
      "description": "`agent_\u2026` or `harness_\u2026`, or the `session_\u2026` handle a `list_session_traces` run came from."
     },
     "trace_id": {
      "type": "string"
     },
     "cursor": {
      "type": "string"
     },
     "limit": {
      "type": "integer"
     },
     "include": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "names": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "errors_only": {
      "type": "boolean"
     },
     "max_chars": {
      "type": "integer"
     }
    },
    "required": [
     "subject_id",
     "trace_id"
    ]
   }
  },
