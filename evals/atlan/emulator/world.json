{
 "tools": [
  {
   "name": "registry__list_workspaces",
   "description": "List the workspaces you hold a role on, each with the handle every write needs. Call this before your first create. If you can reach more than one, say which you are writing to rather than guessing.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "limit": {
      "type": "integer"
     }
    },
    "required": []
   }
  },
  {
   "name": "registry__search_artifacts",
   "description": "Search the artifacts you can see by relevance over their name, description and indexed content. Use this to find something when you do not know its id. Set `semantic` when the wording may differ. Narrow with `kind` (for example `skill`, `agent`, `mcp_server`).",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "query": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "semantic": {
      "type": "boolean"
     },
     "limit": {
      "type": "integer"
     },
     "workspace_id": {
      "type": "string"
     },
     "project_id": {
      "type": "string"
     }
    },
    "required": [
     "query"
    ]
   }
  },
  {
   "name": "registry__list_artifacts",
   "description": "Browse artifacts, most recently changed first. Omit kind to browse discoverable kinds. Use this when you want to see what exists rather than to find a particular thing.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "kind": {
      "type": "string"
     },
     "limit": {
      "type": "integer"
     },
     "offset": {
      "type": "integer"
     },
     "workspace_id": {
      "type": "string"
     },
     "project_id": {
      "type": "string"
     }
    },
    "required": []
   }
  },
  {
   "name": "registry__get_artifact",
   "description": "Read one artifact by its handle, including the kind's own properties. The handle is the `id` a search result carries, shaped `<kind>_<identifier>`. It cannot find anything by name. Set channel (for example latest) or release_id for the exact published version. Set include_file to a path from the artifact's `metadata.files`, such as `SKILL.md`, to read that file's text in the same call instead of a second get_file_content.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "artifact_id": {
      "type": "string"
     },
     "channel": {
      "type": "string"
     },
     "release_id": {
      "type": "string"
     },
     "include_file": {
      "type": "string",
      "description": "A `path` from the artifact's `metadata.files`, such as `SKILL.md`. The result adds `included_file`: that file's text at the version the manifest pins, read exactly as get_file_content reads it. A file that cannot be read keeps the artifact and says why in `included_file.error`."
     }
    },
    "required": [
     "artifact_id"
    ]
   }
  },
  {
   "name": "registry__get_related_artifacts",
   "description": "Read one artifact's typed relationships in both directions. An end with `is_readable: false` is in a workspace you cannot read.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "artifact_id": {
      "type": "string"
     }
    },
    "required": [
     "artifact_id"
    ]
   }
  },
  {
   "name": "registry__get_project",
   "description": "Read a native project by its project_\u2026 handle, including its description, knowledge_urls and containing workspace. To read what is in it, call list_artifacts with project_id; add kind to include a kind hidden from cross-kind discovery. Projects are containers, not artifacts, and do not have artifact releases or typed relationships.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "project_id": {
      "type": "string"
     }
    },
    "required": [
     "project_id"
    ]
   }
  },
  {
   "name": "registry__get_kind_schema",
   "description": "Read one registered kind's schema: the properties it declares, which are required, and the relationship types it permits. Call this before your first create_artifact on a kind.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "kind": {
      "type": "string"
     }
    },
    "required": [
     "kind"
    ]
   }
  },
  {
   "name": "registry__get_file_content",
   "description": "Read a file artifact's text content. This is how you read a skill's `SKILL.md`: `registry__get_artifact` on the skill returns `metadata.files[]`, and each entry's `file_id` and `file_version_ordinal` come here. Text only, up to 256 KiB.",
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "file_id": {
      "type": "string"
     },
     "version_ordinal": {
      "type": "integer"
     }
    },
    "required": [
     "file_id"
    ]
   }
  },
  {
   "name": "registry__create_artifact",
   "description": "Create one artifact of a registered kind. `metadata` carries `name` and `workspace_id` (required) flat alongside the kind's properties.",
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "kind": {
      "type": "string"
     },
     "metadata": {
      "type": "object"
     },
     "content": {
      "type": "string"
     },
     "idempotency_key": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "metadata"
    ]
   },
   "writes": "artifact"
  },
  {
   "name": "registry__patch_artifact",
   "description": "Change some of an artifact's fields, leaving the rest alone.",
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "artifact_id": {
      "type": "string"
     },
     "patch": {
      "type": "object"
     }
    },
    "required": [
     "artifact_id",
     "patch"
    ]
   }
  },
  {
   "name": "registry__append_artifact_version",
   "description": "Append a new immutable version to an existing artifact. Read the head first and pass its etag as if_match. Metadata restates the kind properties and per-version fields; omit line fields such as name, workspace_id and project_id. For file, metadata.path must be the existing path. Supply content as bounded UTF-8 text or metadata.upload_key for staged bytes. Reuse idempotency_key and identical arguments after a lost response to recover the original version, even after the head advances.",
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   },
   "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "artifact_id": {
      "type": "string"
     },
     "metadata": {
      "type": "object"
     },
     "if_match": {
      "type": "string",
      "minLength": 1
     },
     "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
     },
     "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "artifact_id",
     "metadata",
     "if_match"
    ]
   }
  },
  {
   "name": "registry__archive_artifact",
