{
 "about": "Golden journeys: the route each use case in the 3 November Registry and Analytics review should take, cold (a new session) and warm (later in the same session). tools/tests/test_journeys.py checks every call against the skills offline; a live run in a sandbox tenant fills `measured`.",
 "measured_shape": {
  "date": "YYYY-MM-DD",
  "versions": {
   "atlanai": "x.y.z",
   "atlanai-analytics": "x.y.z"
  },
  "tenant": "<sandbox name>",
  "cold": {
   "calls": 0,
   "turns": 0,
   "p50_s": 0,
   "p95_s": 0,
   "kb": 0
  },
  "warm": {
   "calls": 0,
   "turns": 0,
   "p50_s": 0,
   "p95_s": 0,
   "kb": 0
  }
 },
 "journeys": [
  {
   "id": "registry-get-started",
   "plugin": "atlanai",
   "skill": "atlan-get-started",
   "title": "Connect and see what the organization has",
   "route": "Own workspace, the org workspace and two counts as one batch that opens the session; without the batch runner, own workspace first and the rest in parallel",
   "calls": {
    "cold": [
     {
      "tool": "registry__list_workspaces",
      "runner": "call_read_tool",
      "args": {
       "kind": "user_default"
      }
     },
     {
      "tool": "registry__list_workspaces",
      "runner": "call_read_tool",
      "args": {
       "kind": "org_default"
      },
      "group": "g1",
      "workaround_for": "T14"
     },
     {
      "tool": "registry__get_artifact_counts",
      "runner": "call_read_tool",
      "args": {
       "group_by": "kind"
      },
      "group": "g1"
     },
     {
      "tool": "registry__get_artifact_counts",
      "runner": "call_read_tool",
      "args": {
       "group_by": "workspace_id",
       "limit": 5
      },
      "group": "g1"
     }
    ],
    "warm": []
   },
   "budget": {
    "cold": 4,
    "warm": 0
   },
   "targets": {
    "max_kb": 10
   },
   "warm_note": "A routed task skips the check: its own first call opens the session.",
   "measured": null
  },
  {
   "id": "registry-find-artifacts",
   "plugin": "atlanai",
   "skill": "atlan-find-artifacts",
   "title": "Find an existing skill and read the one picked",
   "route": "Scoped search, then the selected artifact",
   "calls": {
    "cold": [
     {
      "tool": "registry__search_artifacts",
      "runner": "call_read_tool",
      "args": {
       "kind": "skill",
       "query": "<task>"
      }
     },
     {
      "tool": "registry__get_artifact",
      "runner": "call_read_tool",
      "args": {
       "artifact_id": "<picked>"
      }
     }
    ],
    "warm": [
     {
      "tool": "registry__search_artifacts",
      "runner": "call_read_tool",
      "args": {
       "kind": "skill",
       "query": "<next task>"
      }
     }
    ]
   },
   "budget": {
    "cold": 2,
    "warm": 1
   },
   "targets": null,
   "measured": null
  },
