{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/command-hooks/publish_hook.py\" session-start --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*call_tool$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/command-hooks/publish_hook.py\" pre --host codex",
            "timeout": 30,
            "statusMessage": "Checking the skill folder"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*call_tool$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/command-hooks/publish_hook.py\" post --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
