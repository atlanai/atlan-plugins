{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/command-hooks/publish_hook.py\" session-start --host cursor",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "call_tool",
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/command-hooks/publish_hook.py\" pre --host cursor",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "matcher": "call_tool",
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/command-hooks/publish_hook.py\" post --host cursor",
        "timeout": 10
      }
    ]
  }
}
