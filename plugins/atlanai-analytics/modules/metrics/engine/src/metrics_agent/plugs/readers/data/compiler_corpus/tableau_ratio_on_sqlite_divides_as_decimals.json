{
  "name": "tableau_ratio_on_sqlite_divides_as_decimals",
  "dialect": "sqlite",
  "unit": {
    "unit_id": "c1",
    "warehouse_tables": [
      "retail.fct_sales"
    ],
    "group_by": [
      "channel"
    ],
    "measures": [
      {
        "name": "m",
        "aggregation": "custom",
        "formula_language": "tableau-calc",
        "formula": "SUM([units_sold]) / SUM([capacity])"
      }
    ],
    "filters": [],
    "top_n": null,
    "join_graph": []
  },
  "expect_sql": "SELECT t.channel,\n       (CAST(SUM(t.units_sold) AS REAL) / NULLIF(SUM(t.capacity), 0)) AS m\nFROM   retail.fct_sales t\nGROUP BY t.channel",
  "expect_coverage": "translated",
  "rules_used": [
    "tableau.divide_operator",
    "tableau.sum"
  ],
  "columns": {
    "retail.fct_sales": [
      "channel",
      "order_date",
      "units_sold",
      "capacity"
    ]
  }
}
