<datasource caption="Fee Ledger" inline='true' name="federated.0fee_ledger" version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption="tix.sqlite" name="genericodbc.0tix_sqlite">
<connection class='genericodbc' dbname='tix.sqlite' odbc-connect-string-extras='' odbc-dbms-name='SQLite' odbc-driver='SQLite3 ODBC Driver' odbc-dsn='' schema='tix' server='' />
</named-connection>
</named-connections>
<relation connection="genericodbc.0tix_sqlite" name='Custom SQL Query' type='text'>SELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,
       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,
       t.service_fee AS amount
FROM tix.tickets t
JOIN tix.orders o ON o.order_id = t.order_id
JOIN tix.events e ON e.event_id = o.event_id
WHERE e.venue_id &lt;&gt; 'V99' AND t.service_fee &gt; 0
UNION ALL
SELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee
FROM tix.tickets t
JOIN tix.orders o ON o.order_id = t.order_id
JOIN tix.events e ON e.event_id = o.event_id
WHERE e.venue_id &lt;&gt; 'V99' AND t.demand_fee &gt; 0
UNION ALL
SELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee
FROM tix.tickets t
JOIN tix.orders o ON o.order_id = t.order_id
JOIN tix.events e ON e.event_id = o.event_id
WHERE e.venue_id &lt;&gt; 'V99' AND t.seller_fee &gt; 0
UNION ALL
SELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee
FROM tix.orders o
JOIN tix.events e ON e.event_id = o.event_id
WHERE e.venue_id &lt;&gt; 'V99' AND o.order_processing_fee &gt; 0
UNION ALL
SELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee
FROM tix.orders o
JOIN tix.events e ON e.event_id = o.event_id
WHERE e.venue_id &lt;&gt; 'V99' AND o.delivery_fee &gt; 0
UNION ALL
SELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',
       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)
FROM tix.refunds r
JOIN tix.orders o ON o.order_id = r.order_id
JOIN tix.events e ON e.event_id = o.event_id
WHERE e.venue_id &lt;&gt; 'V99'
  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded &gt; 0</relation>
<metadata-records>
