<datasource caption="Box Office" inline='true' name="federated.0box_office" version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption="tix.sqlite" name="genericodbc.0tix_sqlite">
<connection class='genericodbc' dbname='tix.sqlite' odbc-connect-string-extras='' odbc-dbms-name='SQLite' odbc-driver='SQLite3 ODBC Driver' odbc-dsn='' schema='tix' server='' />
</named-connection>
</named-connections>
<relation connection="genericodbc.0tix_sqlite" name='Custom SQL Query' type='text'>SELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,
       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,
       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,
       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,
       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated
FROM tix.tickets t
JOIN tix.orders o ON o.order_id = t.order_id
JOIN tix.events e ON e.event_id = t.event_id
JOIN tix.venues v ON v.venue_id = e.venue_id
JOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n
  ON n.order_id = t.order_id
WHERE t.ticket_type = 'primary'
  AND o.status &lt;&gt; 'chargeback'
  AND v.venue_type &lt;&gt; 'test'</relation>
