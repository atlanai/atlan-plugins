<datasource caption="Event Sales" inline='true' name="federated.0event_sales" version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption="tix.sqlite" name="genericodbc.0tix_sqlite">
<connection class='genericodbc' dbname='tix.sqlite' odbc-connect-string-extras='' odbc-dbms-name='SQLite' odbc-driver='SQLite3 ODBC Driver' odbc-dsn='' schema='tix' server='' />
</named-connection>
</named-connections>
<relation connection="genericodbc.0tix_sqlite" name='Custom SQL Query' type='text'>SELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,
       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps
FROM tix.events e
JOIN tix.venues v ON v.venue_id = e.venue_id
LEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status &lt;&gt; 'chargeback'
LEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'
WHERE v.venue_type &lt;&gt; 'test'
GROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity</relation>
