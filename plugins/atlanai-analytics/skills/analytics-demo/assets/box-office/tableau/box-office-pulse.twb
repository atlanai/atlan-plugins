<column caption="Net Fee Revenue" datatype="real" default-format='c"$"#,##0;-"$"#,##0' name="[Calculation_4417101]" role='measure' type='quantitative'>
  <calculation class='tableau' formula="SUM([amount])" />
  <desc><formatted-text><run>Ticketfuddle's own fee income: service, demand, order processing and delivery fees, and both resale fees, less any of those refunded. Facility fees are collected for the venue and are not ours. Dated by order; refunds by the day they were paid.</run></formatted-text></desc>
</column>
