<worksheet name="Fee Take Rate">
<layout-options><title><formatted-text><run>Fees as % of what fans paid</run></formatted-text></title></layout-options>
<table>
<view>
<datasources><datasource caption="Box Office" name="federated.0box_office" /></datasources>
<datasource-dependencies datasource="federated.0box_office">
<column caption="Fee Take Rate" datatype="real" default-format="p0.0%" name="[Calculation_4417003]" role='measure' type='quantitative'><calculation class='tableau' formula="(SUM([service_fee]) + SUM([facility_fee]) + SUM([demand_fee]) + SUM([order_fees_allocated])) / SUM([face_value])" /></column>

<column-instance column="[Calculation_4417003]" derivation='User' name="[usr:Calculation_4417003:qk]" pivot='key' type='quantitative' />
</datasource-dependencies>
<aggregation value='true' />
</view>
<style><style-rule element='cell'><format attr='text-format' field="[federated.0box_office].[usr:Calculation_4417003:qk]" value="p0.0%" /></style-rule></style>
<panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Text" /><encodings><text column="[federated.0box_office].[usr:Calculation_4417003:qk]" /></encodings></pane></panes>
<rows></rows>
<cols></cols>
</table>
