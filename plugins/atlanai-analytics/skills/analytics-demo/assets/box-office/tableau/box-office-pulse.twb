<column caption="Sell-Through" datatype="real" default-format="p0%" name="[Calculation_4417201]" role='measure' type='quantitative'>
  <calculation class='tableau' formula="SUM([tickets_issued]) / SUM([capacity])" />
  <desc><formatted-text><run>Primary tickets issued, guest-list comps included, against the event's own capacity. A seated show in the arena holds fewer than the venue. The sheets show completed events.</run></formatted-text></desc>
