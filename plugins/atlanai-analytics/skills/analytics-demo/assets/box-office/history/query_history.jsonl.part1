{"statement_id": "2e79d264-a166-837a-fd4c-966f2cf59937", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-01T06:00:15.763Z", "end_time": "2026-08-01T06:00:16.674Z", "total_duration_ms": 1674, "read_rows": 22151, "produced_rows": 1}
{"statement_id": "d0a8db3e-274c-5bb8-2a97-81d70520e687", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-01T06:00:16.316Z", "end_time": "2026-08-01T06:00:18.131Z", "total_duration_ms": 2131, "read_rows": 10300, "produced_rows": 16}
{"statement_id": "9fad6061-65fe-d9de-da22-dd3294b922c9", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-01T06:00:18.612Z", "end_time": "2026-08-01T06:00:23.900Z", "total_duration_ms": 5900, "read_rows": 48857, "produced_rows": 7}
{"statement_id": "72b35ae8-1a18-8e65-a70e-8ce1c336f55d", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-01T06:00:39.466Z", "end_time": "2026-08-01T06:00:40.102Z", "total_duration_ms": 1102, "read_rows": 8540, "produced_rows": 17}
{"statement_id": "74c38315-04a5-6ea0-c6b9-86a20d3b200c", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-01T19:48:31.355Z", "end_time": "2026-08-01T19:48:34.801Z", "total_duration_ms": 2832, "read_rows": 1014, "produced_rows": 17}
{"statement_id": "5cb88b28-904e-fd76-f5d7-4ff587f53fab", "executed_by": "sam.chen@ticketfuddle.example", "executed_by_user_id": "707", "execution_status": "FINISHED", "statement_type": "PRAGMA", "statement_text": "PRAGMA tix.table_info(orders)", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-01T21:09:04.338Z", "end_time": "2026-08-01T21:09:06.809Z", "total_duration_ms": 2435, "read_rows": 17516, "produced_rows": 13}
{"statement_id": "ac9c07d6-84cc-2485-40f6-d750c98be747", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-02T06:00:16.695Z", "end_time": "2026-08-02T06:00:19.374Z", "total_duration_ms": 3374, "read_rows": 31239, "produced_rows": 17}
