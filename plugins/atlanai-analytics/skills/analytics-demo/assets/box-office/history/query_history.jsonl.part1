{"statement_id": "75ec0a3e-3aef-b633-dc77-488997d0af7d", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  AND o.order_ts >= '2026-07-01' AND o.order_ts < '2026-10-01'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-18T17:28:42.665Z", "end_time": "2026-08-18T17:28:44.946Z", "total_duration_ms": 2770, "read_rows": 32265, "produced_rows": 1}
