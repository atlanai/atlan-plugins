nded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-06T06:00:13.276Z", "end_time": "2026-08-06T06:00:14.885Z", "total_duration_ms": 1885, "read_rows": 10512, "produced_rows": 7}
{"statement_id": "000f021c-b59a-af1f-0bdd-ee30c2447dac", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-06T06:00:24.368Z", "end_time": "2026-08-06T06:00:27.575Z", "total_duration_ms": 3575, "read_rows": 26371, "produced_rows": 1}
