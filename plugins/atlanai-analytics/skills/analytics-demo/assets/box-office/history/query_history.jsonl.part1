{"statement_id": "18f31908-9c0c-bcd1-13f3-71c04f5d3b64", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT * FROM tix.tickets LIMIT 100", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-18T22:02:03.226Z", "end_time": "2026-08-18T22:02:05.599Z", "total_duration_ms": 1784, "read_rows": 35350, "produced_rows": 100}
{"statement_id": "224bef2e-bbb3-e786-36b7-2bc7851bf877", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-19T06:00:03.293Z", "end_time": "2026-08-19T06:00:06.009Z", "total_duration_ms": 3009, "read_rows": 45550, "produced_rows": 1}
{"statement_id": "2fc85ca8-91ac-e8f3-0f1f-6788b9dc1bdc", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-19T06:00:27.613Z", "end_time": "2026-08-19T06:00:31.942Z", "total_duration_ms": 4942, "read_rows": 56436, "produced_rows": 7}
{"statement_id": "e0432c70-edf0-8935-5989-47a18e95e879", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-19T06:00:33.248Z", "end_time": "2026-08-19T06:00:34.248Z", "total_duration_ms": 1248, "read_rows": 23035, "produced_rows": 16}
{"statement_id": "b69522dd-f1b3-ad7c-bfd1-4677f282cc02", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-19T06:00:40.747Z", "end_time": "2026-08-19T06:00:41.401Z", "total_duration_ms": 1401, "read_rows": 12819, "produced_rows": 17}
{"statement_id": "5fa46446-c8ad-9e68-6b4c-5b9894b8344a", "executed_by": "jo.adeyemi@ticketfuddle.example", "executed_by_user_id": "708", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.customer_id, c.flagged_on, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.customers c\nJOIN tix.orders o ON o.customer_id = c.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE c.account_status = 'bot_suspected' AND t.ticket_type = 'primary'\nGROUP BY 1, 2\nORDER BY 4 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-19T16:07:14.971Z", "end_time": "2026-08-19T16:07:15.822Z", "total_duration_ms": 947, "read_rows": 10918, "produced_rows": 6}
