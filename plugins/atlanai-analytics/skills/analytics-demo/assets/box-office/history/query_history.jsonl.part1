{"statement_id": "80cbfc5a-de23-5a0f-589e-9bc0227b7b35", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(*) FROM tix.customers", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-06T19:57:40.256Z", "end_time": "2026-08-06T19:57:41.581Z", "total_duration_ms": 1088, "read_rows": 2283, "produced_rows": 1}
{"statement_id": "870f5660-b6ab-1528-98b4-3279e2a134bf", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE e.status <> 'cancelled'\nGROUP BY 1, 2\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-06T20:35:58.664Z", "end_time": "2026-08-06T20:35:59.304Z", "total_duration_ms": 856, "read_rows": 44957, "produced_rows": 43}
{"statement_id": "1535742d-8d33-f8ff-5e17-dfae8dd4b7f5", "executed_by": "jo.adeyemi@ticketfuddle.example", "executed_by_user_id": "708", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.customer_id, c.flagged_on, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.customers c\nJOIN tix.orders o ON o.customer_id = c.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE c.account_status = 'bot_suspected' AND t.ticket_type = 'primary'\nGROUP BY 1, 2\nORDER BY 4 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-06T22:28:55.815Z", "end_time": "2026-08-06T22:28:56.222Z", "total_duration_ms": 500, "read_rows": 34288, "produced_rows": 6}
{"statement_id": "8b1db8de-daec-4475-04f1-d491d425d4de", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-07T06:00:17.595Z", "end_time": "2026-08-07T06:00:21.439Z", "total_duration_ms": 4439, "read_rows": 46295, "produced_rows": 7}
{"statement_id": "a46dbe05-29db-6843-f260-16fff6ec2f97", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-07T06:00:21.291Z", "end_time": "2026-08-07T06:00:22.053Z", "total_duration_ms": 1053, "read_rows": 45998, "produced_rows": 17}
{"statement_id": "fe7a0d8a-1e2b-db60-5dcc-9ff36542ec3f", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-07T06:00:37.282Z", "end_time": "2026-08-07T06:00:42.234Z", "total_duration_ms": 5234, "read_rows": 11582, "produced_rows": 1}
{"statement_id": "cd115f43-69ec-92c4-eff7-10e5f26fd85e", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-07T06:00:39.914Z", "end_time": "2026-08-07T06:00:41.156Z", "total_duration_ms": 2156, "read_rows": 36081, "produced_rows": 16}
{"statement_id": "ed440b5c-fe46-1aa5-169b-3638a7a62fe2", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(r.refund_ts, 1, 7) AS refund_month, r.reason, COUNT(*) AS refunds,\n       SUM(r.face_refunded) AS face_refunded,\n       SUM(r.service_fee_refunded + r.facility_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded) AS fees_refunded\nFROM tix.refunds r\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-07T16:40:45.778Z", "end_time": "2026-08-07T16:40:48.477Z", "total_duration_ms": 2482, "read_rows": 25991, "produced_rows": 32}
{"statement_id": "f9985450-a153-0136-275c-bdf11509b31c", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  AND o.order_ts >= '2026-04-01' AND o.order_ts < '2026-07-01'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-07T19:25:22.190Z", "end_time": "2026-08-07T19:25:25.448Z", "total_duration_ms": 3097, "read_rows": 37156, "produced_rows": 1}
