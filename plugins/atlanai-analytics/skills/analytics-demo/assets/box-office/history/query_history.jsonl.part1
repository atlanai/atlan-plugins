{"statement_id": "e8b0c392-4890-b5a0-a947-34553e429eca", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(*) FROM tix.refunds", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-11T22:51:18.382Z", "end_time": "2026-08-11T22:51:20.575Z", "total_duration_ms": 2556, "read_rows": 51673, "produced_rows": 1}
{"statement_id": "95a56e10-be39-8dd3-d26e-7c2e268b8679", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-12T06:00:08.086Z", "end_time": "2026-08-12T06:00:11.541Z", "total_duration_ms": 3541, "read_rows": 10587, "produced_rows": 1}
{"statement_id": "c79cfa82-fb13-e238-ec2b-15473a706c19", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-12T06:00:10.838Z", "end_time": "2026-08-12T06:00:13.068Z", "total_duration_ms": 3068, "read_rows": 37482, "produced_rows": 7}
{"statement_id": "14e10020-7787-33c5-6f8e-5d166f5ce28b", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-12T06:00:13.930Z", "end_time": "2026-08-12T06:00:14.023Z", "total_duration_ms": 1023, "read_rows": 10733, "produced_rows": 17}
{"statement_id": "ac560fb4-4391-8e6e-2ee6-7f5c38f2c214", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-12T06:00:25.780Z", "end_time": "2026-08-12T06:00:29.087Z", "total_duration_ms": 4087, "read_rows": 32615, "produced_rows": 16}
{"statement_id": "abcb7a70-0664-f7d6-f427-540273544565", "executed_by": "sam.chen@ticketfuddle.example", "executed_by_user_id": "707", "execution_status": "FINISHED", "statement_type": "PRAGMA", "statement_text": "PRAGMA tix.table_list", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-12T14:31:02.182Z", "end_time": "2026-08-12T14:31:03.090Z", "total_duration_ms": 598, "read_rows": 30342, "produced_rows": 8}
{"statement_id": "042fcdee-0b1e-5713-8f84-076e2422f8e5", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS resold, AVG(t.resale_price / t.face_value) AS avg_markup\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'resale'\nGROUP BY 1\nORDER BY 3 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-12T15:33:52.521Z", "end_time": "2026-08-12T15:33:53.512Z", "total_duration_ms": 569, "read_rows": 40993, "produced_rows": 15}
{"statement_id": "0735cff6-e8d2-43d0-e6a0-5efdb38875f6", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.on_sale_date, e.capacity, COUNT(t.ticket_id) AS tickets_issued,\n       COUNT(t.ticket_id) * 1.0 / e.capacity AS pct_sold\nFROM tix.events e\nLEFT JOIN tix.tickets t ON t.event_id = e.event_id AND t.ticket_type = 'primary'\nWHERE e.status = 'scheduled'\nGROUP BY 1, 2, 3, 4\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-12T20:41:12.327Z", "end_time": "2026-08-12T20:41:13.675Z", "total_duration_ms": 1076, "read_rows": 36713, "produced_rows": 8}
{"statement_id": "bf492ff4-273b-63ec-ead4-0c8cbbaa664c", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-12T21:12:34.763Z", "end_time": "2026-08-12T21:12:35.574Z", "total_duration_ms": 1013, "read_rows": 1250, "produced_rows": 17}
{"statement_id": "c4c7ba17-7d71-d114-36f8-dd7c3d3a108f", "executed_by": "jo.adeyemi@ticketfuddle.example", "executed_by_user_id": "708", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.customer_id, c.flagged_on, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.customers c\nJOIN tix.orders o ON o.customer_id = c.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE c.account_status = 'bot_suspected' AND t.ticket_type = 'primary'\nGROUP BY 1, 2\nORDER BY 4 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-12T21:46:40.983Z", "end_time": "2026-08-12T21:46:41.580Z", "total_duration_ms": 1242, "read_rows": 42198, "produced_rows": 6}
{"statement_id": "a8a9c264-0dfe-df65-05d3-037d33ee093d", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(t.face_value + t.service_fee + t.facility_fee + t.demand_fee\n           + o.order_processing_fee + o.delivery_fee) AS gross_sales\nFROM tix.orders o\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE t.ticket_type = 'primary'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-12T21:53:10.865Z", "end_time": "2026-08-12T21:53:13.008Z", "total_duration_ms": 2077, "read_rows": 30873, "produced_rows": 17}
