{"statement_id": "e862b44a-ba73-a949-9849-6576fe944267", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-17T06:00:34.129Z", "end_time": "2026-08-17T06:00:39.589Z", "total_duration_ms": 5589, "read_rows": 20471, "produced_rows": 16}
{"statement_id": "3eb3972e-6c01-fde6-6713-e2e8411e1d61", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.on_sale_date, e.capacity, COUNT(t.ticket_id) AS tickets_issued,\n       COUNT(t.ticket_id) * 1.0 / e.capacity AS pct_sold\nFROM tix.events e\nLEFT JOIN tix.tickets t ON t.event_id = e.event_id AND t.ticket_type = 'primary'\nWHERE e.status = 'scheduled'\nGROUP BY 1, 2, 3, 4\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T19:54:31.523Z", "end_time": "2026-08-17T19:54:32.455Z", "total_duration_ms": 1325, "read_rows": 4028, "produced_rows": 8}
{"statement_id": "1a81f583-2164-6cb8-2f2f-0475955c981f", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, v.capacity AS venue_capacity, COUNT(t.ticket_id) AS paid_tickets,\n       COUNT(t.ticket_id) * 1.0 / v.capacity AS sell_through\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN tix.orders o ON o.event_id = e.event_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE e.status = 'completed' AND t.ticket_type = 'primary' AND t.is_comp = 0 AND o.status = 'paid'\nGROUP BY 1, 2, 3\nORDER BY 5 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T20:26:24.248Z", "end_time": "2026-08-17T20:26:25.069Z", "total_duration_ms": 484, "read_rows": 10633, "produced_rows": 36}
{"statement_id": "a83414f1-4392-7de8-dc6a-68835e6067a3", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  AND o.order_ts >= '2026-07-01' AND o.order_ts < '2026-10-01'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T21:19:02.213Z", "end_time": "2026-08-17T21:19:03.251Z", "total_duration_ms": 389, "read_rows": 55752, "produced_rows": 1}
{"statement_id": "5388e937-74a1-7d12-ff5d-2bc8574b5138", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT 'service' AS fee_type, SUM(service_fee) AS amount FROM tix.tickets WHERE ticket_type = 'primary'\nUNION ALL SELECT 'demand', SUM(demand_fee) FROM tix.tickets\nUNION ALL SELECT 'resale_buyer', SUM(service_fee) FROM tix.tickets WHERE ticket_type = 'resale'\nUNION ALL SELECT 'resale_seller', SUM(seller_fee) FROM tix.tickets\nUNION ALL SELECT 'order_processing', SUM(order_processing_fee) FROM tix.orders\nUNION ALL SELECT 'delivery', SUM(delivery_fee) FROM tix.orders", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T21:31:04.776Z", "end_time": "2026-08-17T21:31:06.170Z", "total_duration_ms": 1317, "read_rows": 31148, "produced_rows": 6}
{"statement_id": "b4ec1981-447c-f237-d108-be37c6b20f90", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nWHERE t.event_id = 'E042'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T21:31:32.065Z", "end_time": "2026-08-17T21:31:33.709Z", "total_duration_ms": 883, "read_rows": 37139, "produced_rows": 1}
{"statement_id": "2ae998f3-aa16-a3d5-7cc1-e8020398070b", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.full_name, c.email, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.orders o\nJOIN tix.customers c ON c.customer_id = o.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE o.channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 4 DESC\nLIMIT 25", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T21:57:51.821Z", "end_time": "2026-08-17T21:57:53.281Z", "total_duration_ms": 1573, "read_rows": 6789, "produced_rows": 25}
{"statement_id": "ee4c3e58-77ac-4476-2599-eb5ed4fde649", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(r.refund_ts, 1, 7) AS refund_month, r.reason, COUNT(*) AS refunds,\n       SUM(r.face_refunded) AS face_refunded,\n       SUM(r.service_fee_refunded + r.facility_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded) AS fees_refunded\nFROM tix.refunds r\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-17T22:58:40.719Z", "end_time": "2026-08-17T22:58:43.433Z", "total_duration_ms": 3151, "read_rows": 42263, "produced_rows": 32}
{"statement_id": "17fbbe80-0918-0baa-8211-be0b7d06e6be", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-18T06:00:03.651Z", "end_time": "2026-08-18T06:00:04.682Z", "total_duration_ms": 1682, "read_rows": 16257, "produced_rows": 7}
{"statement_id": "e96e8cb1-9b9b-82d1-e37b-315253c3f0d4", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-18T06:00:11.454Z", "end_time": "2026-08-18T06:00:13.933Z", "total_duration_ms": 2933, "read_rows": 26823, "produced_rows": 17}
{"statement_id": "eff26e64-efec-7482-8bcd-92e1b78839f4", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-18T06:00:12.261Z", "end_time": "2026-08-18T06:00:16.475Z", "total_duration_ms": 4475, "read_rows": 10837, "produced_rows": 1}
{"statement_id": "2eab38ac-da66-2746-c897-3682905c59d3", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-18T06:00:35.200Z", "end_time": "2026-08-18T06:00:38.022Z", "total_duration_ms": 3022, "read_rows": 36674, "produced_rows": 16}
{"statement_id": "f53423da-6f9e-6648-46fe-a34e0ca934f1", "executed_by": "sam.chen@ticketfuddle.example", "executed_by_user_id": "707", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(*) AS orphans\nFROM tix.tickets r\nLEFT JOIN tix.tickets p ON p.ticket_id = r.resale_of_ticket_id\nWHERE r.ticket_type = 'resale' AND p.ticket_id IS NULL", "error_message": null, "client_application": "Jupyter", "start_time": "2026-08-18T14:49:39.964Z", "end_time": "2026-08-18T14:49:40.235Z", "total_duration_ms": 787, "read_rows": 44040, "produced_rows": 1}
