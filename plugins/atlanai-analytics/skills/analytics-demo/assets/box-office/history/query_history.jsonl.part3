{"statement_id": "32363558-8ac8-34e9-429f-1c7467318927", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE e.status <> 'cancelled'\nGROUP BY 1, 2\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-21T17:52:19.748Z", "end_time": "2026-09-21T17:52:22.188Z", "total_duration_ms": 3090, "read_rows": 48202, "produced_rows": 43}
