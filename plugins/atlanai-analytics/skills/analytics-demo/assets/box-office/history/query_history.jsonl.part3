{"statement_id": "81051ce8-b69c-a790-89b7-7957e6e3c90d", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  AND o.order_ts >= '2026-04-01' AND o.order_ts < '2026-07-01'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-29T19:27:17.492Z", "end_time": "2026-09-29T19:27:19.914Z", "total_duration_ms": 2446, "read_rows": 13078, "produced_rows": 1}
{"statement_id": "a7098ec8-ecde-2677-8d67-deab8026c155", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  AND o.order_ts >= '2026-04-01' AND o.order_ts < '2026-07-01'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-29T20:22:15.586Z", "end_time": "2026-09-29T20:22:16.637Z", "total_duration_ms": 1110, "read_rows": 35054, "produced_rows": 1}
