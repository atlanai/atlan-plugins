nded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-24T06:00:13.950Z", "end_time": "2026-09-24T06:00:17.585Z", "total_duration_ms": 4585, "read_rows": 53654, "produced_rows": 7}
{"statement_id": "97a71971-4a7b-6d37-c56b-b36c00f8da92", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-24T06:00:16.263Z", "end_time": "2026-09-24T06:00:20.963Z", "total_duration_ms": 4963, "read_rows": 37867, "produced_rows": 1}
{"statement_id": "1bdd07d9-13f3-9306-2387-47efb8205677", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-24T06:00:28.888Z", "end_time": "2026-09-24T06:00:31.930Z", "total_duration_ms": 3930, "read_rows": 45405, "produced_rows": 17}
{"statement_id": "7a612226-1b66-53b6-11e6-787f8e7f0a74", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.capacity,\n       COUNT(DISTINCT s.ticket_id) AS attended,\n       COUNT(DISTINCT s.ticket_id) * 1.0 / e.capacity AS attendance_rate\nFROM tix.scans s\nJOIN tix.events e ON e.event_id = s.event_id\nWHERE s.result = 'admitted'\nGROUP BY 1, 2, 3\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-24T14:21:29.177Z", "end_time": "2026-09-24T14:21:30.352Z", "total_duration_ms": 1322, "read_rows": 12785, "produced_rows": 35}
{"statement_id": "84ac4778-cbbe-6223-9fdf-e380f6a81137", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH fees AS (\n  SELECT o.event_id, SUM(t.service_fee + t.demand_fee + t.seller_fee) AS amount\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, SUM(o.order_processing_fee + o.delivery_fee)\n  FROM tix.orders o\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, -SUM(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\n  FROM tix.refunds r\n  JOIN tix.orders o ON o.order_id = r.order_id\n  GROUP BY o.event_id\n)\nSELECT substr(e.event_date, 1, 7) AS event_month, SUM(f.amount) AS recognised_fee_revenue\nFROM fees f\nJOIN tix.events e ON e.event_id = f.event_id\nWHERE e.status = 'completed' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-24T15:21:23.800Z", "end_time": "2026-09-24T15:21:25.324Z", "total_duration_ms": 1928, "read_rows": 46292, "produced_rows": 16}
{"statement_id": "5160654d-0036-c123-e896-02adc4aae99f", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(*) FROM tix.artists", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-24T15:33:42.493Z", "end_time": "2026-09-24T15:33:43.312Z", "total_duration_ms": 528, "read_rows": 7081, "produced_rows": 1}
{"statement_id": "9fdb5670-e12c-0493-ba9e-70e0f3563b72", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS resold, AVG(t.resale_price / t.face_value) AS avg_markup\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'resale'\nGROUP BY 1\nORDER BY 3 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-24T16:40:39.081Z", "end_time": "2026-09-24T16:40:42.366Z", "total_duration_ms": 2635, "read_rows": 16045, "produced_rows": 15}
{"statement_id": "cb01c3e3-d592-046d-b3ff-def4ed71317c", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-24T19:59:41.781Z", "end_time": "2026-09-24T19:59:42.583Z", "total_duration_ms": 1330, "read_rows": 56005, "produced_rows": 17}
{"statement_id": "7a50d711-8008-5cb4-0ef1-15e6955f09f9", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-25T06:00:04.878Z", "end_time": "2026-09-25T06:00:08.384Z", "total_duration_ms": 4384, "read_rows": 3691, "produced_rows": 17}
{"statement_id": "7ac8d15e-74d6-d327-cfa8-e7f300f032e2", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-25T06:00:08.490Z", "end_time": "2026-09-25T06:00:11.324Z", "total_duration_ms": 3324, "read_rows": 33610, "produced_rows": 7}
{"statement_id": "bd56ceae-6eeb-04c9-674b-61c10c11d72d", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-25T06:00:20.521Z", "end_time": "2026-09-25T06:00:21.501Z", "total_duration_ms": 1501, "read_rows": 44014, "produced_rows": 16}
{"statement_id": "8ef0924f-4f9e-d04c-3551-1f6d50df7b8a", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-25T06:00:30.590Z", "end_time": "2026-09-25T06:00:35.929Z", "total_duration_ms": 5929, "read_rows": 6061, "produced_rows": 1}
