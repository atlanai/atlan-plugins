nded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-04T06:00:07.135Z", "end_time": "2026-10-04T06:00:12.300Z", "total_duration_ms": 5300, "read_rows": 7880, "produced_rows": 7}
{"statement_id": "e0db5031-985a-71d0-d6a6-d27607eb9850", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-04T06:00:08.052Z", "end_time": "2026-10-04T06:00:13.910Z", "total_duration_ms": 5910, "read_rows": 45321, "produced_rows": 17}
{"statement_id": "1e5c5b16-34ff-6370-3df1-163d673cbde2", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-04T06:00:41.569Z", "end_time": "2026-10-04T06:00:45.040Z", "total_duration_ms": 4040, "read_rows": 16281, "produced_rows": 16}
{"statement_id": "a280f82e-50a5-79fe-4db4-f3a72454c754", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-04T21:03:00.730Z", "end_time": "2026-10-04T21:03:03.177Z", "total_duration_ms": 2768, "read_rows": 36011, "produced_rows": 17}
{"statement_id": "978b169a-82c3-1419-e264-d98e575f97d5", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(*) FROM tix.artists", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-04T22:57:03.023Z", "end_time": "2026-10-04T22:57:04.131Z", "total_duration_ms": 549, "read_rows": 20094, "produced_rows": 1}
{"statement_id": "cc7c9ed1-884c-a83a-9f58-50051a07c0a6", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-05T06:00:17.499Z", "end_time": "2026-10-05T06:00:18.422Z", "total_duration_ms": 1422, "read_rows": 58675, "produced_rows": 16}
{"statement_id": "cb212784-8686-4ab6-f202-37434ba64a47", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-05T06:00:28.981Z", "end_time": "2026-10-05T06:00:30.812Z", "total_duration_ms": 2812, "read_rows": 46297, "produced_rows": 17}
{"statement_id": "367e20e9-df56-ff4e-aad0-bbc9d153b789", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-05T06:00:30.292Z", "end_time": "2026-10-05T06:00:33.552Z", "total_duration_ms": 3552, "read_rows": 29376, "produced_rows": 7}
{"statement_id": "fd8d8fe3-58d7-74f8-bcd8-3f1a1a60dbb2", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-05T06:00:43.583Z", "end_time": "2026-10-05T06:00:46.213Z", "total_duration_ms": 3213, "read_rows": 22581, "produced_rows": 1}
{"statement_id": "f8957dbe-2914-5c90-b3ca-16fc917c93a6", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nWHERE t.event_id = 'E032'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-05T14:20:42.951Z", "end_time": "2026-10-05T14:20:45.760Z", "total_duration_ms": 2963, "read_rows": 1906, "produced_rows": 1}
{"statement_id": "275146a0-5166-c0cd-88e7-fb5f55e77530", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(order_ts, 1, 7) AS order_month, lower(replace(channel, ' ', '_')) AS channel, COUNT(*) AS orders\nFROM tix.orders\nWHERE channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-05T14:22:43.274Z", "end_time": "2026-10-05T14:22:46.350Z", "total_duration_ms": 3190, "read_rows": 16064, "produced_rows": 51}
{"statement_id": "69415d5e-1e73-1115-7d66-4eabaeed5db9", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.capacity,\n       COUNT(DISTINCT s.ticket_id) AS attended,\n       COUNT(DISTINCT s.ticket_id) * 1.0 / e.capacity AS attendance_rate\nFROM tix.scans s\nJOIN tix.events e ON e.event_id = s.event_id\nWHERE s.result = 'admitted'\nGROUP BY 1, 2, 3\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-05T16:06:18.755Z", "end_time": "2026-10-05T16:06:20.660Z", "total_duration_ms": 1912, "read_rows": 26900, "produced_rows": 35}
{"statement_id": "e2d0b6a4-694c-d751-592c-ad19a4a86bb6", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT channel, COUNT(*) AS orders\nFROM tix.orders\nGROUP BY channel\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-05T16:29:22.786Z", "end_time": "2026-10-05T16:29:25.452Z", "total_duration_ms": 2900, "read_rows": 11197, "produced_rows": 7}
{"statement_id": "bd06c135-9018-2315-1f61-1da23cf68d1e", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(order_ts, 1, 7) AS order_month, lower(replace(channel, ' ', '_')) AS channel, COUNT(*) AS orders\nFROM tix.orders\nWHERE channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-05T17:39:08.194Z", "end_time": "2026-10-05T17:39:08.940Z", "total_duration_ms": 693, "read_rows": 16091, "produced_rows": 51}
{"statement_id": "8e65bdf7-15f8-dad5-2188-5a2335835c05", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT 'service' AS fee_type, SUM(service_fee) AS amount FROM tix.tickets WHERE ticket_type = 'primary'\nUNION ALL SELECT 'demand', SUM(demand_fee) FROM tix.tickets\nUNION ALL SELECT 'resale_buyer', SUM(service_fee) FROM tix.tickets WHERE ticket_type = 'resale'\nUNION ALL SELECT 'resale_seller', SUM(seller_fee) FROM tix.tickets\nUNION ALL SELECT 'order_processing', SUM(order_processing_fee) FROM tix.orders\nUNION ALL SELECT 'delivery', SUM(delivery_fee) FROM tix.orders", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-05T17:43:24.837Z", "end_time": "2026-10-05T17:43:26.503Z", "total_duration_ms": 1563, "read_rows": 56026, "produced_rows": 6}
