nded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-31T06:00:17.539Z", "end_time": "2026-08-31T06:00:22.775Z", "total_duration_ms": 5775, "read_rows": 58306, "produced_rows": 7}
{"statement_id": "ed0e1923-6cdf-0378-7887-f95dbb883728", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-31T06:00:20.957Z", "end_time": "2026-08-31T06:00:22.856Z", "total_duration_ms": 2856, "read_rows": 35655, "produced_rows": 17}
{"statement_id": "59b4f7e8-495d-e85d-b6a6-2b0a6b1d3e4f", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-08-31T06:00:24.298Z", "end_time": "2026-08-31T06:00:27.138Z", "total_duration_ms": 3138, "read_rows": 46319, "produced_rows": 16}
{"statement_id": "9b1656da-5551-562a-4f0d-3388fc866b15", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.capacity,\n       COUNT(DISTINCT s.ticket_id) AS attended,\n       COUNT(DISTINCT s.ticket_id) * 1.0 / e.capacity AS attendance_rate\nFROM tix.scans s\nJOIN tix.events e ON e.event_id = s.event_id\nWHERE s.result = 'admitted'\nGROUP BY 1, 2, 3\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-31T15:15:25.940Z", "end_time": "2026-08-31T15:15:28.406Z", "total_duration_ms": 3051, "read_rows": 53296, "produced_rows": 35}
{"statement_id": "96acc429-fab0-0e3a-b97d-7cd71a1a4020", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(r.refund_ts, 1, 7) AS refund_month, r.reason, COUNT(*) AS refunds,\n       SUM(r.face_refunded) AS face_refunded,\n       SUM(r.service_fee_refunded + r.facility_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded) AS fees_refunded\nFROM tix.refunds r\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-31T15:28:23.558Z", "end_time": "2026-08-31T15:28:25.001Z", "total_duration_ms": 1300, "read_rows": 47241, "produced_rows": 32}
{"statement_id": "3cde6cfe-e1b7-56fb-eb92-cba3a6b4b17e", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS tickets, SUM(t.demand_fee) AS demand_fees, AVG(t.demand_fee) AS avg_demand_fee\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.demand_fee > 0\nGROUP BY 1\nORDER BY 3 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-31T15:33:52.687Z", "end_time": "2026-08-31T15:33:53.480Z", "total_duration_ms": 741, "read_rows": 44760, "produced_rows": 4}
{"statement_id": "c7820190-fe17-4e3d-54f7-c48a9fff56ee", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE e.status <> 'cancelled'\nGROUP BY 1, 2\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-31T18:18:18.116Z", "end_time": "2026-08-31T18:18:21.171Z", "total_duration_ms": 2375, "read_rows": 50403, "produced_rows": 43}
{"statement_id": "09634f89-0c3a-af19-36b0-ce82991fcdc5", "executed_by": "sam.chen@ticketfuddle.example", "executed_by_user_id": "707", "execution_status": "FINISHED", "statement_type": "PRAGMA", "statement_text": "PRAGMA tix.table_list", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-31T21:27:33.168Z", "end_time": "2026-08-31T21:27:35.720Z", "total_duration_ms": 1848, "read_rows": 3799, "produced_rows": 8}
{"statement_id": "f15adca6-8c71-9146-a8d9-0b9f111f9648", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH fees AS (\n  SELECT o.event_id, SUM(t.service_fee + t.demand_fee + t.seller_fee) AS amount\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, SUM(o.order_processing_fee + o.delivery_fee)\n  FROM tix.orders o\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, -SUM(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\n  FROM tix.refunds r\n  JOIN tix.orders o ON o.order_id = r.order_id\n  GROUP BY o.event_id\n)\nSELECT substr(e.event_date, 1, 7) AS event_month, SUM(f.amount) AS recognised_fee_revenue\nFROM fees f\nJOIN tix.events e ON e.event_id = f.event_id\nWHERE e.status = 'completed' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-31T22:22:52.432Z", "end_time": "2026-08-31T22:22:54.055Z", "total_duration_ms": 1997, "read_rows": 46616, "produced_rows": 16}
{"statement_id": "df5c968a-f856-a7d5-3532-02e1bd6d5f14", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-01T06:00:07.999Z", "end_time": "2026-09-01T06:00:11.260Z", "total_duration_ms": 4260, "read_rows": 20330, "produced_rows": 17}
{"statement_id": "0e746474-32b4-8cb9-c6f0-589bc1bac3d3", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-01T06:00:11.210Z", "end_time": "2026-09-01T06:00:16.936Z", "total_duration_ms": 5936, "read_rows": 48461, "produced_rows": 1}
{"statement_id": "9ffa183d-d245-07a1-bdf0-21308f115b12", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-01T06:00:20.243Z", "end_time": "2026-09-01T06:00:23.518Z", "total_duration_ms": 3518, "read_rows": 36226, "produced_rows": 7}
{"statement_id": "b172fbb9-8055-db4c-8c61-673f12556fbd", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-01T06:00:22.543Z", "end_time": "2026-09-01T06:00:25.014Z", "total_duration_ms": 3014, "read_rows": 36388, "produced_rows": 16}
{"statement_id": "ac4fde87-d2dc-7d5f-c5ed-369125bb987f", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, v.capacity AS venue_capacity, COUNT(t.ticket_id) AS paid_tickets,\n       COUNT(t.ticket_id) * 1.0 / v.capacity AS sell_through\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN tix.orders o ON o.event_id = e.event_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE e.status = 'completed' AND t.ticket_type = 'primary' AND t.is_comp = 0 AND o.status = 'paid'\nGROUP BY 1, 2, 3\nORDER BY 5 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-01T19:11:47.131Z", "end_time": "2026-09-01T19:11:49.102Z", "total_duration_ms": 1694, "read_rows": 53477, "produced_rows": 36}
{"statement_id": "7b7d7e33-6abb-0c47-8845-cf8e1a35be34", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE e.status <> 'cancelled'\nGROUP BY 1, 2\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-01T22:24:02.114Z", "end_time": "2026-09-01T22:24:05.306Z", "total_duration_ms": 3043, "read_rows": 53305, "produced_rows": 43}
{"statement_id": "9aa511de-45c4-bac1-eb2b-f2bca4d167da", "executed_by": "sam.chen@ticketfuddle.example", "executed_by_user_id": "707", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT o.order_id, o.customer_id, o.order_ts FROM tix.orders o WHERE o.event_id = 'E999'", "error_message": null, "client_application": "Jupyter", "start_time": "2026-09-01T22:35:43.321Z", "end_time": "2026-09-01T22:35:44.079Z", "total_duration_ms": 757, "read_rows": 54476, "produced_rows": 160}
{"statement_id": "7d8469f2-b492-a47b-c47c-7c841c419367", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-02T06:00:11.360Z", "end_time": "2026-09-02T06:00:13.128Z", "total_duration_ms": 2128, "read_rows": 22020, "produced_rows": 16}
