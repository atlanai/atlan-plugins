{"statement_id": "a94c431e-2488-f363-6f20-d2ff77056319", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS attendance\nFROM tix.scans s\nJOIN tix.events e ON e.event_id = s.event_id\nGROUP BY 1\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-28T17:18:43.015Z", "end_time": "2026-08-28T17:18:46.566Z", "total_duration_ms": 2640, "read_rows": 59211, "produced_rows": 16}
{"statement_id": "7f6bcaea-0858-bb80-27c2-3d8c48701521", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH fees AS (\n  SELECT o.event_id, SUM(t.service_fee + t.demand_fee + t.seller_fee) AS amount\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, SUM(o.order_processing_fee + o.delivery_fee)\n  FROM tix.orders o\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, -SUM(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\n  FROM tix.refunds r\n  JOIN tix.orders o ON o.order_id = r.order_id\n  GROUP BY o.event_id\n)\nSELECT substr(e.event_date, 1, 7) AS event_month, SUM(f.amount) AS recognised_fee_revenue\nFROM fees f\nJOIN tix.events e ON e.event_id = f.event_id\nWHERE e.status = 'completed' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-28T18:32:04.175Z", "end_time": "2026-08-28T18:32:07.385Z", "total_duration_ms": 3064, "read_rows": 9266, "produced_rows": 16}
{"statement_id": "9e585aae-3ccc-325d-cb1c-d5e09b2c3eb3", "executed_by": "jo.adeyemi@ticketfuddle.example", "executed_by_user_id": "708", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.customer_id, c.flagged_on, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.customers c\nJOIN tix.orders o ON o.customer_id = c.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE c.account_status = 'bot_suspected' AND t.ticket_type = 'primary'\nGROUP BY 1, 2\nORDER BY 4 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-28T20:12:16.519Z", "end_time": "2026-08-28T20:12:18.294Z", "total_duration_ms": 1629, "read_rows": 46945, "produced_rows": 6}
{"statement_id": "12ead7ab-a360-7b20-62a1-b5405b175800", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.on_sale_date, e.capacity, COUNT(t.ticket_id) AS tickets_issued,\n       COUNT(t.ticket_id) * 1.0 / e.capacity AS pct_sold\nFROM tix.events e\nLEFT JOIN tix.tickets t ON t.event_id = e.event_id AND t.ticket_type = 'primary'\nWHERE e.status = 'scheduled'\nGROUP BY 1, 2, 3, 4\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-08-28T20:20:55.758Z", "end_time": "2026-08-28T20:20:57.894Z", "total_duration_ms": 2464, "read_rows": 37738, "produced_rows": 8}
