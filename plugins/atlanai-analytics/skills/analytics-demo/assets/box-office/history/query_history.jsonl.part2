{"statement_id": "a5a7284b-fa72-f756-d3fb-b0bdf024947e", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-15T06:00:42.816Z", "end_time": "2026-09-15T06:00:46.176Z", "total_duration_ms": 4176, "read_rows": 22721, "produced_rows": 17}
{"statement_id": "c9a0a55e-c772-3945-b0a1-edadeff68213", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT v.venue_name, SUM(t.facility_fee) AS facility_fees_owed\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nWHERE e.status = 'completed' AND o.status NOT IN ('refunded', 'chargeback')\nGROUP BY 1\nORDER BY 2 DESC", "error_message": null, "client_application": "Python (sqlite3)", "start_time": "2026-09-15T17:06:32.001Z", "end_time": "2026-09-15T17:06:34.373Z", "total_duration_ms": 1619, "read_rows": 51616, "produced_rows": 7}
{"statement_id": "a4b2fcd7-a238-1254-2f88-63e519cbf8eb", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.full_name, c.email, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.orders o\nJOIN tix.customers c ON c.customer_id = o.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE o.channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 4 DESC\nLIMIT 25", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-15T17:58:49.733Z", "end_time": "2026-09-15T17:58:51.551Z", "total_duration_ms": 1584, "read_rows": 6460, "produced_rows": 25}
{"statement_id": "89b96a2a-6809-9c5e-b7b9-7fe6f4710ff2", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS resold, AVG(t.resale_price / t.face_value) AS avg_markup\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'resale'\nGROUP BY 1\nORDER BY 3 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-15T21:12:54.558Z", "end_time": "2026-09-15T21:12:54.878Z", "total_duration_ms": 842, "read_rows": 2680, "produced_rows": 15}
{"statement_id": "0f14ced8-1579-0ddb-baf5-15596371eab6", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-16T06:00:07.773Z", "end_time": "2026-09-16T06:00:12.737Z", "total_duration_ms": 5737, "read_rows": 3563, "produced_rows": 17}
{"statement_id": "cd5b60c3-d314-06b5-3ab6-836677020c2e", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-16T06:00:08.554Z", "end_time": "2026-09-16T06:00:13.964Z", "total_duration_ms": 5964, "read_rows": 54633, "produced_rows": 16}
{"statement_id": "aa884b23-3b6e-f951-963b-a21f8e87bf93", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-16T06:00:13.723Z", "end_time": "2026-09-16T06:00:14.449Z", "total_duration_ms": 1449, "read_rows": 50590, "produced_rows": 7}
{"statement_id": "0dd12d3a-9aa7-34d3-a338-9c3059f21d37", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-16T06:00:14.086Z", "end_time": "2026-09-16T06:00:19.482Z", "total_duration_ms": 5482, "read_rows": 27496, "produced_rows": 1}
{"statement_id": "41068209-d371-15a9-af65-df8bfbfb35d3", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH fees AS (\n  SELECT o.event_id, SUM(t.service_fee + t.demand_fee + t.seller_fee) AS amount\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, SUM(o.order_processing_fee + o.delivery_fee)\n  FROM tix.orders o\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, -SUM(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\n  FROM tix.refunds r\n  JOIN tix.orders o ON o.order_id = r.order_id\n  GROUP BY o.event_id\n)\nSELECT substr(e.event_date, 1, 7) AS event_month, SUM(f.amount) AS recognised_fee_revenue\nFROM fees f\nJOIN tix.events e ON e.event_id = f.event_id\nWHERE e.status = 'completed' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-16T14:17:55.004Z", "end_time": "2026-09-16T14:17:56.968Z", "total_duration_ms": 1003, "read_rows": 4378, "produced_rows": 16}
{"statement_id": "804478c5-cb38-57df-52de-55275badd8b9", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT * FROM tix.events LIMIT 100", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-16T14:42:15.993Z", "end_time": "2026-09-16T14:42:18.146Z", "total_duration_ms": 2617, "read_rows": 2413, "produced_rows": 46}
{"statement_id": "fd27710b-88e6-e2f0-44d1-b9a100bdbea4", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-16T15:11:02.251Z", "end_time": "2026-09-16T15:11:03.019Z", "total_duration_ms": 555, "read_rows": 46957, "produced_rows": 17}
{"statement_id": "93b570a9-03e1-7599-86ad-11fb04a784ff", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH paid AS (\n  SELECT o.order_id,\n         substr(o.order_ts, 1, 4) || '-Q' || ((CAST(substr(o.order_ts, 6, 2) AS INTEGER) + 2) / 3) AS order_quarter,\n         SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) + MAX(o.order_processing_fee + o.delivery_fee) AS fees\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  JOIN tix.events e ON e.event_id = t.event_id\n  WHERE t.ticket_type = 'primary' AND o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  GROUP BY o.order_id, order_quarter\n)\nSELECT order_quarter, SUM(fees) / SUM(face + fees) AS fee_share_of_total_paid\nFROM paid\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-16T16:01:44.214Z", "end_time": "2026-09-16T16:01:45.297Z", "total_duration_ms": 372, "read_rows": 8773, "produced_rows": 7}
{"statement_id": "3c6904b1-86f7-7198-0faf-9ddee2873fcc", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.on_sale_date, e.capacity, COUNT(t.ticket_id) AS tickets_issued,\n       COUNT(t.ticket_id) * 1.0 / e.capacity AS pct_sold\nFROM tix.events e\nLEFT JOIN tix.tickets t ON t.event_id = e.event_id AND t.ticket_type = 'primary'\nWHERE e.status = 'scheduled'\nGROUP BY 1, 2, 3, 4\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-16T18:03:58.692Z", "end_time": "2026-09-16T18:03:58.302Z", "total_duration_ms": 142, "read_rows": 7571, "produced_rows": 8}
{"statement_id": "00833818-6be8-2479-1482-3eb36296db1a", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.weather, COUNT(DISTINCT s.ticket_id) AS attended\nFROM tix.events e\nJOIN tix.scans s ON s.event_id = e.event_id AND s.result = 'admitted'\nWHERE e.venue_id = 'V05'\nGROUP BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-16T20:06:11.971Z", "end_time": "2026-09-16T20:06:14.862Z", "total_duration_ms": 3050, "read_rows": 46187, "produced_rows": 3}
