{"statement_id": "46a16355-5570-d4e6-bce7-2935789daf17", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, AVG(t.face_value) AS avg_ticket_price\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'primary'\nGROUP BY 1\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-07T19:52:35.401Z", "end_time": "2026-09-07T19:52:38.177Z", "total_duration_ms": 2722, "read_rows": 17697, "produced_rows": 17}
{"statement_id": "0b20c0fd-2c66-ef9d-851e-f017dfd62d4e", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS tickets, SUM(t.demand_fee) AS demand_fees, AVG(t.demand_fee) AS avg_demand_fee\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.demand_fee > 0\nGROUP BY 1\nORDER BY 3 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-07T22:28:58.874Z", "end_time": "2026-09-07T22:29:00.978Z", "total_duration_ms": 2105, "read_rows": 50943, "produced_rows": 4}
{"statement_id": "fc9db46c-cfac-15ec-877c-87d890d1054a", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-08T06:00:24.565Z", "end_time": "2026-09-08T06:00:28.659Z", "total_duration_ms": 4659, "read_rows": 26051, "produced_rows": 17}
{"statement_id": "dc12e4d4-a588-c43a-1278-dc347d7cf08e", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-08T06:00:33.699Z", "end_time": "2026-09-08T06:00:35.999Z", "total_duration_ms": 2999, "read_rows": 472, "produced_rows": 16}
{"statement_id": "33462fb2-9d67-522b-7edd-f270f7df09fe", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-08T06:00:34.078Z", "end_time": "2026-09-08T06:00:36.446Z", "total_duration_ms": 2446, "read_rows": 23741, "produced_rows": 7}
{"statement_id": "28b7f420-6ce1-6fc1-b1ec-81afdfce5fb3", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-08T06:00:40.820Z", "end_time": "2026-09-08T06:00:45.531Z", "total_duration_ms": 5531, "read_rows": 24019, "produced_rows": 1}
{"statement_id": "9abdf54c-0807-6ad8-947d-5306c5e902a7", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(order_ts, 1, 7) AS order_month, lower(replace(channel, ' ', '_')) AS channel, COUNT(*) AS orders\nFROM tix.orders\nWHERE channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-08T14:32:00.405Z", "end_time": "2026-09-08T14:32:02.662Z", "total_duration_ms": 2540, "read_rows": 19478, "produced_rows": 51}
{"statement_id": "dfe8d351-cc4e-7ede-c79c-e9edb60d55e6", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH fees AS (\n  SELECT o.event_id, SUM(t.service_fee + t.demand_fee + t.seller_fee) AS amount\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, SUM(o.order_processing_fee + o.delivery_fee)\n  FROM tix.orders o\n  GROUP BY o.event_id\n  UNION ALL\n  SELECT o.event_id, -SUM(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\n  FROM tix.refunds r\n  JOIN tix.orders o ON o.order_id = r.order_id\n  GROUP BY o.event_id\n)\nSELECT substr(e.event_date, 1, 7) AS event_month, SUM(f.amount) AS recognised_fee_revenue\nFROM fees f\nJOIN tix.events e ON e.event_id = f.event_id\nWHERE e.status = 'completed' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-08T18:38:31.461Z", "end_time": "2026-09-08T18:38:33.319Z", "total_duration_ms": 1785, "read_rows": 47302, "produced_rows": 16}
{"statement_id": "054fcb69-a268-5da2-96b4-0bcb5dc456c1", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, AVG(t.face_value) AS avg_ticket_price\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'primary'\nGROUP BY 1\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-09-08T21:23:31.782Z", "end_time": "2026-09-08T21:23:33.971Z", "total_duration_ms": 2907, "read_rows": 58467, "produced_rows": 17}
{"statement_id": "ff597ecc-74bd-4ef1-d461-3e773d967cdd", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-09-09T06:00:06.431Z", "end_time": "2026-09-09T06:00:10.931Z", "total_duration_ms": 4931, "read_rows": 23792, "produced_rows": 1}
