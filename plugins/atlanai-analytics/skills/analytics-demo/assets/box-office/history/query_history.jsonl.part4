nded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-25T06:00:36.700Z", "end_time": "2026-10-25T06:00:39.009Z", "total_duration_ms": 3009, "read_rows": 36664, "produced_rows": 7}
{"statement_id": "381c3797-f06f-3039-354e-71f65a0155a2", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-25T06:00:40.026Z", "end_time": "2026-10-25T06:00:44.276Z", "total_duration_ms": 4276, "read_rows": 9399, "produced_rows": 16}
