nded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-23T06:00:39.847Z", "end_time": "2026-10-23T06:00:43.827Z", "total_duration_ms": 4827, "read_rows": 52982, "produced_rows": 7}
{"statement_id": "3eed5ff1-267d-e6fc-dffc-a61bcfa7c914", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(order_ts, 1, 7) AS order_month, lower(replace(channel, ' ', '_')) AS channel, COUNT(*) AS orders\nFROM tix.orders\nWHERE channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-23T14:21:51.802Z", "end_time": "2026-10-23T14:21:54.585Z", "total_duration_ms": 2744, "read_rows": 5410, "produced_rows": 51}
{"statement_id": "328c6606-efb2-aaba-be1f-8e691023bcea", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH paid AS (\n  SELECT o.order_id,\n         substr(o.order_ts, 1, 4) || '-Q' || ((CAST(substr(o.order_ts, 6, 2) AS INTEGER) + 2) / 3) AS order_quarter,\n         SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) + MAX(o.order_processing_fee + o.delivery_fee) AS fees\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  JOIN tix.events e ON e.event_id = t.event_id\n  WHERE t.ticket_type = 'primary' AND o.status <> 'chargeback' AND e.venue_id <> 'V99'\n    AND o.order_ts >= '2026-07-01' AND o.order_ts < '2026-10-01'\n  GROUP BY o.order_id, order_quarter\n)\nSELECT SUM(fees) / SUM(face + fees) AS fee_share_of_total_paid\nFROM paid", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-23T16:11:24.916Z", "end_time": "2026-10-23T16:11:25.362Z", "total_duration_ms": 1320, "read_rows": 30332, "produced_rows": 1}
{"statement_id": "8833f0ec-ef66-13ee-cdbe-f6583fcf70de", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nWHERE t.event_id = 'E035'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-23T18:27:49.015Z", "end_time": "2026-10-23T18:27:49.562Z", "total_duration_ms": 551, "read_rows": 3776, "produced_rows": 1}
{"statement_id": "d68479de-d2d5-2e0e-feb9-8bea81b5b0cb", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, COUNT(*) AS tickets, SUM(t.demand_fee) AS demand_fees, AVG(t.demand_fee) AS avg_demand_fee\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.demand_fee > 0\nGROUP BY 1\nORDER BY 3 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-23T20:06:06.896Z", "end_time": "2026-10-23T20:06:07.792Z", "total_duration_ms": 1579, "read_rows": 43293, "produced_rows": 4}
{"statement_id": "d7dcfc38-1392-2689-bbd3-7e981537f59e", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE e.status <> 'cancelled'\nGROUP BY 1, 2\nORDER BY 2 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-23T21:33:17.927Z", "end_time": "2026-10-23T21:33:19.446Z", "total_duration_ms": 1845, "read_rows": 31852, "produced_rows": 43}
{"statement_id": "77bf95b7-0886-fe98-e981-ae655b652f27", "executed_by": "sam.chen@ticketfuddle.example", "executed_by_user_id": "707", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT * FROM tix.tickets LIMIT 100", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-23T22:27:09.121Z", "end_time": "2026-10-23T22:27:12.275Z", "total_duration_ms": 2430, "read_rows": 13568, "produced_rows": 100}
{"statement_id": "01589ae1-28b8-5e5f-7fe1-b8185fd66012", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-24T06:00:07.262Z", "end_time": "2026-10-24T06:00:09.995Z", "total_duration_ms": 2995, "read_rows": 4947, "produced_rows": 7}
{"statement_id": "9893c4d6-506b-118e-c14d-25404e0776ea", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-24T06:00:13.942Z", "end_time": "2026-10-24T06:00:17.401Z", "total_duration_ms": 4401, "read_rows": 30372, "produced_rows": 17}
{"statement_id": "e3e6cf48-c4df-621d-7abf-9fdf558a65b0", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-24T06:00:21.124Z", "end_time": "2026-10-24T06:00:24.721Z", "total_duration_ms": 3721, "read_rows": 29303, "produced_rows": 1}
{"statement_id": "bb0e4525-eaf9-ad60-a90d-823206902258", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-24T06:00:41.764Z", "end_time": "2026-10-24T06:00:45.733Z", "total_duration_ms": 4733, "read_rows": 38582, "produced_rows": 16}
{"statement_id": "9ff0ee75-52ed-6c0a-d83f-1aa74bc83e4c", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name,\n       SUM(t.service_fee + t.facility_fee + t.demand_fee)\n         / SUM(t.face_value + t.service_fee + t.facility_fee + t.demand_fee) AS fee_share\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'primary' AND t.is_comp = 0 AND e.event_id = 'E032'\nGROUP BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-24T19:55:44.306Z", "end_time": "2026-10-24T19:55:45.251Z", "total_duration_ms": 770, "read_rows": 39186, "produced_rows": 1}
