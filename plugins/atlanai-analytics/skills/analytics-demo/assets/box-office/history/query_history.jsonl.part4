{"statement_id": "f1fd5b2a-6cfd-6042-c43f-f520e5aa99cd", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-19T06:00:10.361Z", "end_time": "2026-10-19T06:00:13.621Z", "total_duration_ms": 3621, "read_rows": 58973, "produced_rows": 16}
{"statement_id": "996bb6a8-2060-9fcd-21be-1081992641ae", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-19T06:00:26.137Z", "end_time": "2026-10-19T06:00:27.122Z", "total_duration_ms": 1122, "read_rows": 31535, "produced_rows": 1}
{"statement_id": "2105fea8-365b-5ef3-80e5-04d9beeb6550", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-19T06:00:29.048Z", "end_time": "2026-10-19T06:00:32.330Z", "total_duration_ms": 3330, "read_rows": 12862, "produced_rows": 17}
{"statement_id": "6b3b3cd7-2103-c7f6-e38e-f21b103ee75a", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name,\n       SUM(t.service_fee + t.facility_fee + t.demand_fee)\n         / SUM(t.face_value + t.service_fee + t.facility_fee + t.demand_fee) AS fee_share\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'primary' AND t.is_comp = 0 AND e.event_id = 'E034'\nGROUP BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T14:39:58.070Z", "end_time": "2026-10-19T14:39:59.617Z", "total_duration_ms": 991, "read_rows": 31928, "produced_rows": 1}
{"statement_id": "2dd6fab4-c28b-552e-0876-b36a79778e22", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.on_sale_date, e.capacity, COUNT(t.ticket_id) AS tickets_issued,\n       COUNT(t.ticket_id) * 1.0 / e.capacity AS pct_sold\nFROM tix.events e\nLEFT JOIN tix.tickets t ON t.event_id = e.event_id AND t.ticket_type = 'primary'\nWHERE e.status = 'scheduled'\nGROUP BY 1, 2, 3, 4\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T16:36:47.677Z", "end_time": "2026-10-19T16:36:49.123Z", "total_duration_ms": 1731, "read_rows": 3953, "produced_rows": 8}
{"statement_id": "4f961849-066a-4029-af23-8af7c41289da", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT 'service' AS fee_type, SUM(service_fee) AS amount FROM tix.tickets WHERE ticket_type = 'primary'\nUNION ALL SELECT 'demand', SUM(demand_fee) FROM tix.tickets\nUNION ALL SELECT 'resale_buyer', SUM(service_fee) FROM tix.tickets WHERE ticket_type = 'resale'\nUNION ALL SELECT 'resale_seller', SUM(seller_fee) FROM tix.tickets\nUNION ALL SELECT 'order_processing', SUM(order_processing_fee) FROM tix.orders\nUNION ALL SELECT 'delivery', SUM(delivery_fee) FROM tix.orders", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T17:31:16.996Z", "end_time": "2026-10-19T17:31:17.314Z", "total_duration_ms": 1020, "read_rows": 4816, "produced_rows": 6}
{"statement_id": "f914cf19-7f91-e599-b9a7-308f037e06f1", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.on_sale_date, e.capacity, COUNT(t.ticket_id) AS tickets_issued,\n       COUNT(t.ticket_id) * 1.0 / e.capacity AS pct_sold\nFROM tix.events e\nLEFT JOIN tix.tickets t ON t.event_id = e.event_id AND t.ticket_type = 'primary'\nWHERE e.status = 'scheduled'\nGROUP BY 1, 2, 3, 4\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T19:54:01.501Z", "end_time": "2026-10-19T19:54:02.948Z", "total_duration_ms": 1830, "read_rows": 41564, "produced_rows": 8}
{"statement_id": "a36a6703-5389-6fc7-1eb9-2a57ca1f7cc1", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(order_ts, 1, 7) AS order_month, lower(replace(channel, ' ', '_')) AS channel, COUNT(*) AS orders\nFROM tix.orders\nWHERE channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T20:35:05.992Z", "end_time": "2026-10-19T20:35:06.848Z", "total_duration_ms": 1489, "read_rows": 7809, "produced_rows": 51}
{"statement_id": "c279afd2-db23-c051-ad10-52dc4152ffc1", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH paid AS (\n  SELECT o.order_id,\n         substr(o.order_ts, 1, 4) || '-Q' || ((CAST(substr(o.order_ts, 6, 2) AS INTEGER) + 2) / 3) AS order_quarter,\n         SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) + MAX(o.order_processing_fee + o.delivery_fee) AS fees\n  FROM tix.tickets t\n  JOIN tix.orders o ON o.order_id = t.order_id\n  JOIN tix.events e ON e.event_id = t.event_id\n  WHERE t.ticket_type = 'primary' AND o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  GROUP BY o.order_id, order_quarter\n)\nSELECT order_quarter, SUM(fees) / SUM(face + fees) AS fee_share_of_total_paid\nFROM paid\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T21:21:56.518Z", "end_time": "2026-10-19T21:21:56.392Z", "total_duration_ms": 186, "read_rows": 173, "produced_rows": 7}
{"statement_id": "9a0e61dc-10bf-368c-b387-322f3e683ed2", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\n  AND o.order_ts >= '2026-04-01' AND o.order_ts < '2026-07-01'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T21:35:27.086Z", "end_time": "2026-10-19T21:35:29.121Z", "total_duration_ms": 2056, "read_rows": 20025, "produced_rows": 1}
{"statement_id": "6fe56b0a-ebec-829a-3486-21baf1de94bf", "executed_by": "maya.okafor@ticketfuddle.example", "executed_by_user_id": "701", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "WITH ticket_fees AS (\n  SELECT t.order_id, SUM(t.face_value) AS face,\n         SUM(t.service_fee + t.facility_fee + t.demand_fee) AS ticket_fees\n  FROM tix.tickets t\n  WHERE t.ticket_type = 'primary'\n  GROUP BY t.order_id\n)\nSELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(f.ticket_fees + o.order_processing_fee + o.delivery_fee) / SUM(f.face) AS take_rate\nFROM ticket_fees f\nJOIN tix.orders o ON o.order_id = f.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE o.status <> 'chargeback' AND e.venue_id <> 'V99'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T21:41:44.454Z", "end_time": "2026-10-19T21:41:46.916Z", "total_duration_ms": 2558, "read_rows": 5527, "produced_rows": 17}
{"statement_id": "a00ca75e-4e78-7fe4-2e74-c9f3be32ed2e", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(t.face_value + t.service_fee + t.facility_fee + t.demand_fee\n           + o.order_processing_fee + o.delivery_fee) AS gross_sales\nFROM tix.orders o\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE t.ticket_type = 'primary'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-19T22:13:45.764Z", "end_time": "2026-10-19T22:13:45.714Z", "total_duration_ms": 543, "read_rows": 19966, "produced_rows": 17}
{"statement_id": "2b13b6bc-b798-2c59-b36d-442aa733f4ac", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-20T06:00:11.800Z", "end_time": "2026-10-20T06:00:16.601Z", "total_duration_ms": 5601, "read_rows": 19099, "produced_rows": 1}
{"statement_id": "6c9c892d-a02c-b0c1-d855-92ef0f1b9a66", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-20T06:00:23.034Z", "end_time": "2026-10-20T06:00:27.970Z", "total_duration_ms": 4970, "read_rows": 57272, "produced_rows": 7}
{"statement_id": "1de41595-c486-93a0-f79b-6aec6fd73639", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-20T06:00:28.849Z", "end_time": "2026-10-20T06:00:30.194Z", "total_duration_ms": 2194, "read_rows": 21908, "produced_rows": 17}
{"statement_id": "91cc1650-b196-10d0-cd9f-0a26685dce4a", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-20T06:00:31.483Z", "end_time": "2026-10-20T06:00:34.548Z", "total_duration_ms": 3548, "read_rows": 16, "produced_rows": 16}
{"statement_id": "ad4894a3-1a27-2111-0883-5a88a7335b4f", "executed_by": "ana.silva@ticketfuddle.example", "executed_by_user_id": "705", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT c.full_name, c.email, COUNT(DISTINCT o.order_id) AS orders, COUNT(t.ticket_id) AS tickets\nFROM tix.orders o\nJOIN tix.customers c ON c.customer_id = o.customer_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE o.channel <> 'resale'\nGROUP BY 1, 2\nORDER BY 4 DESC\nLIMIT 25", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T14:47:31.930Z", "end_time": "2026-10-20T14:47:34.704Z", "total_duration_ms": 3128, "read_rows": 9530, "produced_rows": 25}
{"statement_id": "2fb2cc33-0759-f92b-3ad7-f168f1dcdc39", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(o.order_ts, 1, 7) AS order_month,\n       SUM(t.face_value + t.service_fee + t.facility_fee + t.demand_fee\n           + o.order_processing_fee + o.delivery_fee) AS gross_sales\nFROM tix.orders o\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE t.ticket_type = 'primary'\nGROUP BY 1\nORDER BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T17:08:42.133Z", "end_time": "2026-10-20T17:08:45.169Z", "total_duration_ms": 2840, "read_rows": 22214, "produced_rows": 17}
{"statement_id": "89b65f1f-f314-7561-7fbe-ea316397f800", "executed_by": "tom.reyes@ticketfuddle.example", "executed_by_user_id": "702", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(r.refund_ts, 1, 7) AS refund_month, r.reason, COUNT(*) AS refunds,\n       SUM(r.face_refunded) AS face_refunded,\n       SUM(r.service_fee_refunded + r.facility_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded) AS fees_refunded\nFROM tix.refunds r\nGROUP BY 1, 2\nORDER BY 1, 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T18:04:04.659Z", "end_time": "2026-10-20T18:04:06.191Z", "total_duration_ms": 1280, "read_rows": 14873, "produced_rows": 32}
{"statement_id": "f50431b6-60f4-c6ca-9735-e8ee8dd5c9a2", "executed_by": "press.office@ticketfuddle.example", "executed_by_user_id": "703", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name,\n       SUM(t.service_fee + t.facility_fee + t.demand_fee)\n         / SUM(t.face_value + t.service_fee + t.facility_fee + t.demand_fee) AS fee_share\nFROM tix.tickets t\nJOIN tix.events e ON e.event_id = t.event_id\nWHERE t.ticket_type = 'primary' AND t.is_comp = 0 AND e.event_id = 'E029'\nGROUP BY 1", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T18:25:29.421Z", "end_time": "2026-10-20T18:25:29.845Z", "total_duration_ms": 428, "read_rows": 56994, "produced_rows": 1}
{"statement_id": "e33e2466-dd3a-a631-678c-5fcd6691ae5b", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, v.capacity AS venue_capacity, COUNT(t.ticket_id) AS paid_tickets,\n       COUNT(t.ticket_id) * 1.0 / v.capacity AS sell_through\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN tix.orders o ON o.event_id = e.event_id\nJOIN tix.tickets t ON t.order_id = o.order_id\nWHERE e.status = 'completed' AND t.ticket_type = 'primary' AND t.is_comp = 0 AND o.status = 'paid'\nGROUP BY 1, 2, 3\nORDER BY 5 DESC", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T18:26:27.266Z", "end_time": "2026-10-20T18:26:29.905Z", "total_duration_ms": 2168, "read_rows": 59975, "produced_rows": 36}
{"statement_id": "c0869e71-8420-1b66-53a8-4b0c1acc5225", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT e.event_name, e.event_date, e.capacity,\n       COUNT(DISTINCT s.ticket_id) AS attended,\n       COUNT(DISTINCT s.ticket_id) * 1.0 / e.capacity AS attendance_rate\nFROM tix.scans s\nJOIN tix.events e ON e.event_id = s.event_id\nWHERE s.result = 'admitted'\nGROUP BY 1, 2, 3\nORDER BY 2", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T19:26:10.441Z", "end_time": "2026-10-20T19:26:11.232Z", "total_duration_ms": 727, "read_rows": 38333, "produced_rows": 35}
{"statement_id": "3e60b10f-0461-49a2-13aa-e284678cfd8c", "executed_by": "leo.marsh@ticketfuddle.example", "executed_by_user_id": "704", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(t.ticket_id) AS tickets_sold\nFROM tix.tickets t\nWHERE t.event_id = 'E042'", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T20:00:54.711Z", "end_time": "2026-10-20T20:00:57.881Z", "total_duration_ms": 3003, "read_rows": 16444, "produced_rows": 1}
{"statement_id": "7ea707fa-cfb1-e446-4476-b820e24af78d", "executed_by": "priya.nair@ticketfuddle.example", "executed_by_user_id": "706", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT * FROM tix.venues LIMIT 100", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T20:48:01.801Z", "end_time": "2026-10-20T20:48:01.905Z", "total_duration_ms": 632, "read_rows": 18105, "produced_rows": 7}
{"statement_id": "4c2ff4fd-9d85-e00c-22d6-861e960557ad", "executed_by": "jo.adeyemi@ticketfuddle.example", "executed_by_user_id": "708", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT COUNT(*) FROM tix.payments", "error_message": null, "client_application": "DB Browser for SQLite", "start_time": "2026-10-20T21:41:49.457Z", "end_time": "2026-10-20T21:41:50.681Z", "total_duration_ms": 1540, "read_rows": 5070, "produced_rows": 1}
{"statement_id": "d7a398a6-1daa-028b-305a-c6c6ee4f9c28", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT substr(\"Custom SQL Query\".\"order_date\", 1, 7) || '-01' AS \"tmn:order_date:ok\", SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\" + \"Custom SQL Query\".\"facility_fee\" + \"Custom SQL Query\".\"demand_fee\" + \"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:fees:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-21T06:00:04.539Z", "end_time": "2026-10-21T06:00:07.380Z", "total_duration_ms": 3380, "read_rows": 27741, "produced_rows": 17}
{"statement_id": "a3a00daa-774a-6fbb-765b-b68354f933c7", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"fee_type\" AS \"none:fee_type:nk\", SUM(\"Custom SQL Query\".\"amount\") AS \"sum:amount:ok\"\nFROM (\nSELECT o.order_id, substr(o.order_ts, 1, 10) AS entry_date, o.event_id,\n       CASE WHEN t.ticket_type = 'resale' THEN 'resale_buyer' ELSE 'service' END AS fee_type,\n       t.service_fee AS amount\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.service_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'demand', t.demand_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.demand_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'resale_seller', t.seller_fee\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND t.seller_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'order_processing', o.order_processing_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.order_processing_fee > 0\nUNION ALL\nSELECT o.order_id, substr(o.order_ts, 1, 10), o.event_id, 'delivery', o.delivery_fee\nFROM tix.orders o\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99' AND o.delivery_fee > 0\nUNION ALL\nSELECT r.order_id, substr(r.refund_ts, 1, 10), o.event_id, 'refunded',\n       -(r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded)\nFROM tix.refunds r\nJOIN tix.orders o ON o.order_id = r.order_id\nJOIN tix.events e ON e.event_id = o.event_id\nWHERE e.venue_id <> 'V99'\n  AND r.service_fee_refunded + r.demand_fee_refunded + r.order_fees_refunded > 0\n) \"Custom SQL Query\"\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-21T06:00:14.242Z", "end_time": "2026-10-21T06:00:18.475Z", "total_duration_ms": 4475, "read_rows": 27464, "produced_rows": 7}
{"statement_id": "bd9f1ae3-fda6-5b5f-2e37-58adf2ae7f29", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT \"Custom SQL Query\".\"event_name\" AS \"none:event_name:nk\", SUM(\"Custom SQL Query\".\"tickets_issued\") AS \"sum:tickets_issued:ok\", SUM(\"Custom SQL Query\".\"capacity\") AS \"sum:capacity:ok\"\nFROM (\nSELECT e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity,\n       COUNT(t.ticket_id) AS tickets_issued, COALESCE(SUM(t.is_comp), 0) AS comps\nFROM tix.events e\nJOIN tix.venues v ON v.venue_id = e.venue_id\nLEFT JOIN tix.orders o ON o.event_id = e.event_id AND o.status <> 'chargeback'\nLEFT JOIN tix.tickets t ON t.order_id = o.order_id AND t.ticket_type = 'primary'\nWHERE v.venue_type <> 'test'\nGROUP BY e.event_id, e.event_name, e.event_date, e.status, v.venue_name, v.venue_type, e.capacity\n) \"Custom SQL Query\"\nWHERE \"Custom SQL Query\".\"status\" = 'completed'\nGROUP BY 1", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-21T06:00:23.622Z", "end_time": "2026-10-21T06:00:25.662Z", "total_duration_ms": 2662, "read_rows": 11907, "produced_rows": 16}
{"statement_id": "fd676885-36e3-7bb1-33a1-95d699512a0e", "executed_by": "svc-tableau@ticketfuddle.example", "executed_by_user_id": "799", "execution_status": "FINISHED", "statement_type": "SELECT", "statement_text": "SELECT SUM(\"Custom SQL Query\".\"face_value\") AS \"sum:face_value:ok\", SUM(\"Custom SQL Query\".\"service_fee\") AS \"sum:service_fee:ok\", SUM(\"Custom SQL Query\".\"facility_fee\") AS \"sum:facility_fee:ok\", SUM(\"Custom SQL Query\".\"demand_fee\") AS \"sum:demand_fee:ok\", SUM(\"Custom SQL Query\".\"order_fees_allocated\") AS \"sum:order_fees_allocated:ok\"\nFROM (\nSELECT t.ticket_id, t.order_id, t.event_id, e.event_name, e.event_date, e.status AS event_status,\n       v.venue_name, v.venue_type, o.order_ts, substr(o.order_ts, 1, 10) AS order_date,\n       lower(replace(o.channel, ' ', '_')) AS channel, t.tier, t.is_comp,\n       t.face_value, t.service_fee, t.facility_fee, t.demand_fee,\n       (o.order_processing_fee + o.delivery_fee) * 1.0 / n.tickets_in_order AS order_fees_allocated\nFROM tix.tickets t\nJOIN tix.orders o ON o.order_id = t.order_id\nJOIN tix.events e ON e.event_id = t.event_id\nJOIN tix.venues v ON v.venue_id = e.venue_id\nJOIN (SELECT order_id, COUNT(*) AS tickets_in_order FROM tix.tickets GROUP BY order_id) n\n  ON n.order_id = t.order_id\nWHERE t.ticket_type = 'primary'\n  AND o.status <> 'chargeback'\n  AND v.venue_type <> 'test'\n) \"Custom SQL Query\"", "error_message": null, "client_application": "Tableau", "start_time": "2026-10-21T06:00:33.546Z", "end_time": "2026-10-21T06:00:34.144Z", "total_duration_ms": 1144, "read_rows": 39513, "produced_rows": 1}
