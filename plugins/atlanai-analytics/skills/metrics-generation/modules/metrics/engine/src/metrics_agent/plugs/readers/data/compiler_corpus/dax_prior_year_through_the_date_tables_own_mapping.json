{
  "name": "dax_prior_year_through_the_date_tables_own_mapping",
  "dialect": "snowflake",
  "unit": {
    "warehouse_tables": [
      "retail.fct_sales",
      "retail.dim_date"
    ],
    "group_by": [
      "retail_year"
    ],
    "group_by_tables": [
      "retail.dim_date"
    ],
    "filters": [],
    "top_n": null,
    "join_graph": [
      {
        "from_table": "retail.fct_sales",
        "from_column": "date_sk",
        "to_table": "retail.dim_date",
        "to_column": "date_sk",
        "cardinality": "M:1",
        "kind": "relationship",
        "is_active": true
      }
    ],
    "unit_id": "lk",
    "measures": [
      {
        "name": "Sales",
        "aggregation": null,
        "formula_language": "dax",
        "formula": "SUM(Sales[amount])"
      },
      {
        "name": "Sales LY",
        "aggregation": null,
        "formula_language": "dax",
        "formula": "CALCULATE(SUM(Sales[amount]), FILTER(ALL('Date'), 'Date'[calendar_date] IN VALUES('Date'[prior_year_date])))"
      }
    ]
  },
  "expect_sql": "SELECT u.k1 AS retail_year,\n       MAX(u.s1) AS sales,\n       (MAX(u.s2)) AS sales_ly\nFROM (\nSELECT j1.retail_year AS k1,\n       SUM(t.amount) AS s1,\n       NULL AS s2\nFROM   retail.fct_sales t\nLEFT JOIN retail.dim_date j1 ON j1.date_sk = t.date_sk\nGROUP BY j1.retail_year\n  UNION ALL\nSELECT c.k1 AS k1,\n       NULL AS s1,\n       SUM(t.amount) AS s2\nFROM   (\n  SELECT DISTINCT c.k1, s.date_sk AS dt\n  FROM   (\n    SELECT DISTINCT d.retail_year AS k1, d.prior_year_date AS dt\n    FROM   retail.dim_date d\n  ) c\n  JOIN retail.dim_date s ON s.calendar_date = c.dt\n) c\nJOIN retail.fct_sales t ON t.date_sk = c.dt\nGROUP BY c.k1\n) u\nGROUP BY u.k1",
  "expect_coverage": "translated",
  "rules_used": [
    "dax.calculate.filter",
    "dax.sum",
    "engine.dax_date_set_lookup",
    "engine.dax_time_intelligence",
    "engine.dax_time_lookup"
  ],
  "columns": {
