  "expect_sql": "SELECT u.k1 AS month_start,\n       MAX(u.s1) AS sales,\n       (MAX(u.s2)) AS sales_lm\nFROM (\nSELECT j1.month_start AS k1,\n       SUM(t.amount) AS s1,\n       NULL AS s2\nFROM   retail.fct_sales t\nLEFT JOIN retail.dim_date j1 ON j1.date_sk = t.date_sk\nGROUP BY j1.month_start\n  UNION ALL\nSELECT c.k1 AS k1,\n       NULL AS s1,\n       SUM(t.amount) AS s2\nFROM   (\n  SELECT DISTINCT c.k1, s.calendar_date AS dt\n  FROM   (\n    SELECT d.month_start AS k1, d.calendar_date AS dt, LAG(d.calendar_date) OVER (PARTITION BY d.month_start ORDER BY d.calendar_date) AS prev\n    FROM   retail.dim_date d\n  ) c\n  JOIN retail.dim_date s ON s.calendar_date BETWEEN DATEADD(MONTH, -1, c.dt) AND CASE WHEN c.dt = LAST_DAY(c.dt) AND c.prev = DATEADD(DAY, -1, c.dt) THEN LAST_DAY(DATEADD(MONTH, -1, c.dt)) ELSE DATEADD(MONTH, -1, c.dt) END\n) c\nJOIN retail.dim_date kd ON kd.calendar_date = c.dt\nJOIN retail.fct_sales t ON t.date_sk = kd.date_sk\nGROUP BY c.k1\n) u\nGROUP BY u.k1",
  "expect_coverage": "translated",
