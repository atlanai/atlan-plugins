{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics_agent/a4_quarantine.schema.json",
  "title": "A4 quarantine",
  "description": "BI statements the witness did not pass, reported rather than silently dropped.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "repair_budget": {
      "type": "integer",
      "minimum": 0
    },
    "note": {
      "type": "string"
    },
    "quarantined": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "result",
          "error"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repair_budget",
    "note",
    "quarantined"
  ]
}
